# LankaLux Admin Console — environment variable NAMES only.
# Copy to .env.local and fill in values. Never commit real secrets.

# --- Supabase (existing production project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=client-uploads

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Email (SMTP). SMTP_PASSWORD is a compatibility alias for SMTP_PASS. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=

# --- Email via Resend (optional; replaces SMTP when set). Lets agents send from their own
# @lankalux.com address. EMAIL_REPLY_DOMAIN + RESEND_WEBHOOK_SECRET bring client replies into admin.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_REPLY_DOMAIN=reply.lankalux.com
# Agents' Zoho logins (app passwords), so their admin emails go out through Zoho and appear in their Sent folder.
# Format: oneth@lankalux.com:app-password,nimal@lankalux.com:app-password. SMTP_USER/SMTP_PASS covers hello@.
ZOHO_SMTP_ACCOUNTS=

# --- Public URLs ---
NEXT_PUBLIC_APP_URL=https://admin.lankalux.com
NEXT_PUBLIC_JOURNEY_URL=https://journey.lankalux.com
NEXT_PUBLIC_WHATSAPP_BUSINESS=94763261788
