# Copy to /etc/lankalux-agents/env on the VM (owner root, mode 600). Never commit real values.

# Supabase Postgres through the Supavisor pooler, session mode (port 5432), as the restricted
# lankalux_agent role. NOT the service-role key. Shamika sets the password in the SQL editor.
AGENT_DATABASE_URL=postgresql://lankalux_agent.evmsntnprujqfejkmipq:CHANGE_ME@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Local Ollama (bound to 127.0.0.1 only).
OLLAMA_URL=http://127.0.0.1:11434
AGENT_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text

# Worker identity and pacing.
WORKER_ID=oracle-a1-1
POLL_SECONDS=5
LEASE_SECONDS=600

# Admin endpoints the agents call for side effects that already live in admin
# (itinerary generation, email). Signed with a shared secret; filled in Phase 5.
ADMIN_AGENT_API_URL=https://admin.lankalux.com/api/agent
ADMIN_AGENT_API_SECRET=

# Lead Scout: Reddit's official API, read-only, app-only token from a free "script" app at
# https://www.reddit.com/prefs/apps. Leave empty to skip Reddit. REDDIT_USERNAME is the account
# that owns the app (Reddit asks for it in the user agent); no password is needed or stored.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
